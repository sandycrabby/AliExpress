# Required to talk to Telegram. Create a bot with @BotFather (see README).
TELEGRAM_BOT_TOKEN=

# Optional. If empty, the first person who sends /start becomes the owner.
# After /start the bot will tell you this chat's numeric id — paste it here
# to lock alerts to that chat even after a restart.
TELEGRAM_CHAT_ID=

# How often to check prices. Default 3 hours (several times a day).
# Examples: 3h, 2h, 90m, 10800
CHECK_INTERVAL=3h

# Ship-to country and currency used for every price check.
# Keep these stable so history is comparable (US + USD is the default).
SHIP_TO_COUNTRY=US
CURRENCY=USD

# Where SQLite stores watches and price history.
DATABASE_PATH=./data/monitor.db

# playwright = real AliExpress (needs Chromium).
# mock     = read prices from MOCK_PRICES_PATH (for local/CI tests).
FETCH_MODE=playwright

# JSON file used when FETCH_MODE=mock.
# Keys are AliExpress product ids, values are numbers or {price, title, currency}.
MOCK_PRICES_PATH=./tests/fixtures/mock_prices.json

# Re-alert if the price drops this much after the last alert (percent or absolute).
ALERT_DROP_PERCENT=2
ALERT_DROP_ABS=1

# Seconds to wait between items during a check (be polite to AliExpress).
CHECK_DELAY_SECONDS=4

# Tiny status page (watch list + last check). Set STATUS_PORT=0 to disable.
STATUS_HOST=0.0.0.0
STATUS_PORT=8080

# Playwright
PLAYWRIGHT_HEADLESS=true
NAVIGATION_TIMEOUT_MS=45000
